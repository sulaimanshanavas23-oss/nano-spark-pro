# Server-side admin token for /admin certificate management.
# Required in production. Use a long random value.
ADMIN_TOKEN=

# Production certificate storage (Upstash Redis REST or Vercel KV).
# Set both values in Vercel Project Settings -> Environment Variables.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional: only needed if the certificate API is hosted on a different origin.
# VITE_API_BASE_URL=
